---
import Layout from '@layouts/Default.astro';

const skills = {
  languages: ['TypeScript', 'Python', 'Rust', 'C'],
  frontend: ['React', 'Three Fiber', 'WebGL'],
  backend: ['Node.js', 'FastAPI', 'SQL'],
  systems: ['Linux', 'Docker', 'Systems'],
};

const projects = [
  {
    name: 'Shefixu',
    subtitle: '3D AI Companion',
    tech: 'TypeScript • React • WebGL • FastAPI',
    description:
      'Real-time conversational 3D interface with VRM avatars and synchronized lip-sync using Web Audio FFT analysis.',
    link: 'https://github.com/lumacodes',
  },
  {
    name: 'HNLINK',
    subtitle: 'Content Automation',
    tech: 'Python • APIs • Web Scraping',
    description:
      'Pipeline that curates trending Hacker News posts and transforms them into polished LinkedIn content automatically.',
    link: 'https://github.com/lumacodes',
  },
  {
    name: 'Gentoo Kernel',
    subtitle: 'Systems Optimization',
    tech: 'Linux • Systems • Performance',
    description:
      'Finely tuned minimal kernel configuration prioritizing hardware efficiency and removing cruft.',
    link: 'https://github.com/lumacodes',
  },
];

const repoCount = 22;
const languageCount = 6;
const monthlyContributions = 699;
const weeklyHeatmap = Array.from({ length: 35 }, (_, index) => {
  const palette = ['#ebedf0', '#dcfce7', '#bbf7d0', '#4ade80', '#166534'];
  return {
    key: `heat-${index}`,
    color: palette[index % palette.length],
  };
});
---

<Layout
  title='Home'
  pageTitle='subhajit'
  description='B.Tech Information Technology student building AI systems and full-stack products.'
>
  <main class='bg-white'>
    <div class='grid grid-cols-1 lg:grid-cols-4 gap-0'>
      {/* Left Column - Main Content (3 out of 4 columns) */}
      <div class='col-span-1 lg:col-span-3 border-b lg:border-b-0 lg:border-r border-black/10'>
        {/* Hero Section */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <div class='mb-8 space-y-3'>
              <p class='text-xs font-medium uppercase tracking-[0.15em] text-black/50'>
                Product Engineer
              </p>
              <h1 class='text-4xl font-black leading-tight sm:text-5xl md:text-6xl lg:text-6xl tracking-tighter'>
                Subhajit Kumar Das
              </h1>
            </div>

            <p class='mb-8 text-base sm:text-lg md:text-lg font-light leading-relaxed text-black/70 max-w-2xl'>
              B.Tech Information Technology student building at the intersection of AI systems,
              full-stack engineering, and thoughtful product design.
            </p>

            <div class='flex flex-wrap gap-3 text-sm'>
              <a href='https://github.com/lumacodes' target='_blank' rel='noopener' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>GitHub</span>
              </a>
              <a href='https://linkedin.com/in/subhajitkumardas' target='_blank' rel='noopener' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>LinkedIn</span>
              </a>
              <a href='https://subhajitdas.hashnode.dev' target='_blank' rel='noopener' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>Blog</span>
              </a>
              <a href='https://luma.is-a.dev' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>Website</span>
              </a>
            </div>
          </div>
        </section>

        {/* Projects Section */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <h2 class='mb-10 text-2xl sm:text-3xl md:text-4xl font-black tracking-tight'>
              Selected Work
            </h2>

            <div class='space-y-10'>
              {projects.map((project, idx) => (
                <a
                  href={project.link}
                  target='_blank'
                  rel='noopener'
                  class='group block'
                >
                  <article class='border-l-4 border-transparent hover:border-black/60 pl-6 py-2 transition-all duration-300'>
                    <div class='mb-3 flex flex-col gap-2'>
                      <div class='flex items-baseline gap-3'>
                        <span class='text-lg text-black/40 font-light'>0{idx + 1}</span>
                        <h3 class='text-2xl sm:text-3xl font-bold'>{project.name}</h3>
                      </div>
                      <span class='text-xs sm:text-sm text-black/50 italic font-light'>{project.subtitle}</span>
                    </div>
                    <p class='mb-3 text-xs uppercase tracking-[0.08em] text-black/40 font-medium'>
                      {project.tech}
                    </p>
                    <p class='text-sm sm:text-base leading-relaxed text-black/70'>
                      {project.description}
                    </p>
                    <div class='mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300'>
                      <span class='text-xs sm:text-sm font-medium flex items-center gap-2'>
                        <span>→</span>
                        <span>View Repository</span>
                      </span>
                    </div>
                  </article>
                </a>
              ))}
            </div>

            <div class='mt-12 pt-8 border-t border-black/10'>
              <a 
                href='https://github.com/lumacodes?tab=repositories' 
                target='_blank' 
                rel='noopener'
                class='inline-flex items-center justify-center px-6 py-3 border-2 border-black text-xs font-bold uppercase tracking-[0.1em] hover:bg-black hover:text-white transition-all duration-300'
              >
                View More Projects →
              </a>
            </div>
          </div>
        </section>

        {/* Skills Section */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <h2 class='mb-10 text-2xl sm:text-3xl md:text-4xl font-black tracking-tight'>
              Technical Stack
            </h2>

            <div class='grid gap-8 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4'>
              {Object.entries(skills).map(([category, items]) => (
                <div class='space-y-3'>
                  <h3 class='text-xs font-bold uppercase tracking-[0.12em] text-black/50 pb-2 border-b border-black/20'>
                    {category.replace(/([A-Z])/g, ' $1').trim()}
                  </h3>
                  <ul class='space-y-2'>
                    {items.map((skill) => (
                      <li class='text-sm text-black/80'>• {skill}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Open Source & Education */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div class='grid gap-10 sm:gap-12 md:grid-cols-2'>
            <div class='space-y-4'>
              <h2 class='text-lg sm:text-xl font-bold border-l-4 border-black pl-4'>
                Open Source
              </h2>
              <p class='text-sm leading-relaxed text-black/70'>
                Contributed to <a href='https://github.com/is-a-dev/register' class='underline hover:opacity-60 transition-opacity'>is-a-dev/register</a>, maintaining free developer subdomains. Active on GitHub with 22+ public repositories spanning AI, automation, systems, and tooling.
              </p>
            </div>
            <div class='space-y-4'>
              <h2 class='text-lg sm:text-xl font-bold border-l-4 border-black pl-4'>
                Education
              </h2>
              <div>
                <p class='text-sm font-medium text-black/90'>B.Tech in Information Technology</p>
                <p class='text-xs sm:text-sm text-black/70 leading-relaxed'>
                  Guru Nanak Institute of Technology<br />
                  2025 – 2029
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* Interests Section */}
        <section class='px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <h2 class='mb-8 text-lg sm:text-xl font-bold border-l-4 border-black pl-4'>
              Interests & Focus
            </h2>
            <div class='flex flex-wrap gap-2 sm:gap-3'>
              {['AI Systems', 'Developer Tooling', 'Linux Internals', 'Privacy Tech', '3D Interfaces', 'Open Source'].map((interest) => (
                <span class='px-3 py-2 border border-black/20 text-xs sm:text-sm font-medium rounded hover:bg-black/5 hover:border-black/40 transition-all cursor-pointer'>
                  {interest}
                </span>
              ))}
            </div>
          </div>
        </section>
      </div>

      {/* Right Sidebar - GitHub Contributions (1 out of 4 columns) */}
      <aside class='col-span-1 flex flex-col bg-[#f9f7f4] px-4 py-8 sm:px-6 lg:px-6 gap-8 overflow-y-auto border-t lg:border-t-0 lg:border-l border-black/10 lg:sticky lg:top-0 lg:h-screen'>
        <div class='rounded-2xl border border-black/10 bg-white p-4 shadow-[0_8px_30px_rgba(0,0,0,0.04)]'>
          <div class='space-y-4'>
            <h3 class='text-[10px] font-bold uppercase tracking-[0.18em] text-black/60'>GitHub Activity</h3>
            <p class='text-xs text-black/50'>This month</p>
          </div>

          <div class='mt-5 rounded-xl border border-black/10 bg-[#f9fafb] p-3'>
            <div class='mb-4 flex items-center justify-between'>
              <span class='text-[10px] font-bold uppercase tracking-[0.12em] text-black/50'>Total</span>
              <span class='text-xl font-black text-black'>{monthlyContributions.toLocaleString()}</span>
            </div>

            <div class='grid grid-cols-7 gap-[3px]'>
              {weeklyHeatmap.map((cell) => (
                <div
                  class='h-2 w-2 rounded-[2px] border border-black/5'
                  style={`background: ${cell.color};`}
                />
              ))}
            </div>

            <div class='mt-3 flex items-center justify-between text-[10px] text-black/40'>
              <span>Mon</span>
              <span>Wed</span>
              <span>Fri</span>
            </div>

            <p class='mt-4 text-center text-xs text-black/40 font-medium'>
              <a href='https://github.com/lumacodes' target='_blank' rel='noopener' class='underline hover:opacity-60'>
                View full profile →
              </a>
            </p>
          </div>
        </div>

        <div class='rounded-2xl border border-black/10 bg-white p-4 shadow-[0_8px_30px_rgba(0,0,0,0.04)]'>
          <div class='space-y-4'>
            <h3 class='text-[10px] font-bold uppercase tracking-[0.18em] text-black/60'>Quick Stats</h3>
            <div class='space-y-3'>
              <div class='flex items-center justify-between rounded-lg bg-[#f5f5f3] px-3 py-2'>
                <span class='text-xs text-black/60'>Repositories</span>
                <span class='text-lg font-bold text-black'>{repoCount.toLocaleString()}</span>
              </div>
              <div class='flex items-center justify-between rounded-lg bg-[#f5f5f3] px-3 py-2'>
                <span class='text-xs text-black/60'>Languages</span>
                <span class='text-lg font-bold text-black'>{languageCount.toLocaleString()}</span>
              </div>
              <div class='flex items-center justify-between rounded-lg bg-[#f5f5f3] px-3 py-2'>
                <span class='text-xs text-black/60'>Contributions</span>
                <span class='text-lg font-bold text-black'>{monthlyContributions.toLocaleString()}</span>
              </div>
            </div>
          </div>
        </div>

        <div class='space-y-3 pt-1'>
          <a 
            href='/resume'
            class='flex w-full items-center justify-center px-4 py-3 bg-black text-white text-xs font-bold uppercase tracking-[0.1em] rounded-xl hover:bg-black/90 transition-all shadow-[0_10px_25px_rgba(0,0,0,0.12)]'
          >
            Resume
          </a>
          <a 
            href='mailto:subhajitkumardas@outlook.com' 
            class='flex w-full items-center justify-center px-4 py-3 border border-black/20 bg-white text-xs font-bold uppercase tracking-[0.1em] rounded-xl hover:bg-black/5 transition-all'
          >
            Contact Me
          </a>
          <a 
            href='https://github.com/lumacodes' 
            target='_blank'
            rel='noopener'
            class='flex w-full items-center justify-center px-4 py-2.5 border border-black/20 bg-white text-xs font-bold uppercase tracking-[0.1em] rounded-xl hover:bg-black/5 transition-all'
          >
            GitHub Profile
          </a>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style>
  a {
    transition: opacity 0.2s ease;
  }

  a:hover {
    opacity: 0.6;
  }
</style>
