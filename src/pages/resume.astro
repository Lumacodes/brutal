---
import Default from "../layouts/Default.astro";
---

<Default title="Resume - Subhajit Kumar Das">
  <div class="min-h-screen bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16 sm:px-8 lg:px-0">
      <!-- Header -->
      <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-black">
          SUBHAJIT KUMAR DAS
        </h1>
        <p class="mt-2 text-sm text-black/70">
          B.Tech Information Technology Student | AI & Full-Stack Developer | Systems & Open Source
        </p>
        <div class="mt-4 flex flex-wrap justify-center gap-4 text-xs text-black/60">
          <span>Kolkata, India</span>
          <span>•</span>
          <a href="https://github.com/lumacodes" class="hover:text-black underline">github.com/lumacodes</a>
          <span>•</span>
          <a href="https://linkedin.com/in/subhajitkumardas" class="hover:text-black underline">LinkedIn</a>
          <span>•</span>
          <a href="https://luma.is-a.dev" class="hover:text-black underline">luma.is-a.dev</a>
        </div>
      </div>

      <!-- Profile -->
      <section class="mb-8">
        <h2 class="mb-3 border-b border-black/20 pb-2 text-sm font-bold uppercase tracking-wide">Profile</h2>
        <p class="text-sm leading-relaxed text-black/80">
          Information Technology undergraduate building software across AI interfaces, automation, frontend systems, and Linux tooling. Experienced in turning ambitious ideas into working prototypes with an emphasis on practical engineering, developer experience, privacy, and open-source software.
        </p>
      </section>

      <!-- Technical Skills -->
      <section class="mb-8">
        <h2 class="mb-3 border-b border-black/20 pb-2 text-sm font-bold uppercase tracking-wide">Technical Skills</h2>
        <div class="space-y-2 text-sm text-black/80">
          <p><span class="font-semibold">Languages:</span> TypeScript, JavaScript, Python, C, Rust</p>
          <p><span class="font-semibold">Frontend:</span> React, React Three Fiber, Three.js, Vite, HTML, CSS, Framer Motion</p>
          <p><span class="font-semibold">Backend:</span> FastAPI, Node.js, REST APIs, SQL Fundamentals</p>
          <p><span class="font-semibold">AI/ML:</span> LLM APIs, Speech Interfaces, AI Automation, RAG Concepts</p>
          <p><span class="font-semibold">Systems:</span> Linux, Gentoo, Bash, Kernel Configuration, Wayland/Hyprland</p>
          <p><span class="font-semibold">Tools:</span> Git, GitHub, Docker, VS Code/Code-OSS, Figma</p>
        </div>
      </section>

      <!-- Selected Projects -->
      <section class="mb-8">
        <h2 class="mb-3 border-b border-black/20 pb-2 text-sm font-bold uppercase tracking-wide">Selected Projects</h2>
        <div class="space-y-6">
          <!-- Shefixu -->
          <div>
            <h3 class="font-semibold text-black">Shefixu — Real-Time 3D AI Companion</h3>
            <p class="text-xs text-black/60">TypeScript, React, React Three Fiber, Three.js, VRM, Web Audio, FastAPI</p>
            <ul class="mt-2 space-y-1 text-sm text-black/80">
              <li>• Built a browser-based 3D AI interface combining a VRM avatar with procedural animation and Web Audio FFT-driven morph-target lip synchronization.</li>
              <li>• Integrated browser speech recognition with local Microsoft Neural TTS via edge-tts/FastAPI to power real-time voice interaction.</li>
              <li>• Designed the system as a modular real-time interaction pipeline rather than a conventional chatbot UI.</li>
            </ul>
          </div>

          <!-- HNLINK -->
          <div>
            <h3 class="font-semibold text-black">HNLINK — Hacker News to LinkedIn Automation</h3>
            <p class="text-xs text-black/60">Python, AI APIs, Content Extraction, Automation</p>
            <ul class="mt-2 space-y-1 text-sm text-black/80">
              <li>• Developed an end-to-end content automation pipeline that monitors trending Hacker News stories and extracts article content and metadata.</li>
              <li>• Used AI APIs to generate LinkedIn-ready posts from extracted content and automated delivery of the final output.</li>
            </ul>
          </div>

          <!-- Gentoo Kernel -->
          <div>
            <h3 class="font-semibold text-black">Gentoo Kernel — Unbloated Custom Kernel</h3>
            <p class="text-xs text-black/60">Linux, Gentoo, Kernel Configuration, Systems</p>
            <ul class="mt-2 space-y-1 text-sm text-black/80">
              <li>• Manually configured a minimal Gentoo Linux kernel with hardware-focused tuning and removal of unnecessary features.</li>
              <li>• Demonstrated hands-on understanding of Linux configuration and systems-level performance trade-offs.</li>
            </ul>
          </div>

          <!-- Aesthetic VS Code Rice -->
          <div>
            <h3 class="font-semibold text-black">Aesthetic VS Code Rice — Developer Environment</h3>
            <p class="text-xs text-black/60">Linux, Code-OSS, UI Customization</p>
            <ul class="mt-2 space-y-1 text-sm text-black/80">
              <li>• Created a minimal Code-OSS configuration focused on a transparent UI, blur-friendly layout, and a distraction-free development workflow.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Open Source -->
      <section class="mb-8">
        <h2 class="mb-3 border-b border-black/20 pb-2 text-sm font-bold uppercase tracking-wide">Open Source</h2>
        <ul class="space-y-1 text-sm text-black/80">
          <li>• <span class="font-semibold">is-a-dev/register</span> — Contributed to a large public open-source project providing free developer subdomains; repository shows substantial community activity.</li>
          <li>• <span class="font-semibold">GitHub:</span> 22 public repositories spanning AI, frontend, automation, Linux customization, and developer tooling.</li>
        </ul>
      </section>

      <!-- Education -->
      <section class="mb-8">
        <h2 class="mb-3 border-b border-black/20 pb-2 text-sm font-bold uppercase tracking-wide">Education</h2>
        <div>
          <p class="font-semibold text-black">B.Tech in Information Technology</p>
          <p class="text-sm text-black/80">Guru Nanak Institute of Technology | 2025 – 2029</p>
        </div>
      </section>

      <!-- Interests -->
      <section>
        <h2 class="mb-3 border-b border-black/20 pb-2 text-sm font-bold uppercase tracking-wide">Interests</h2>
        <p class="text-sm text-black/80">
          AI Systems, Developer Tooling, Linux Internals, Privacy-Preserving Software, 3D Interfaces, Automation, Open Source
        </p>
      </section>

      <!-- Download & Back -->
      <div class="mt-12 flex gap-3 border-t border-black/20 pt-8">
        <a 
          href="/" 
          class="inline-flex items-center px-4 py-2 text-xs font-bold uppercase tracking-[0.1em] text-black/70 hover:text-black transition-colors"
        >
          ← Back
        </a>
      </div>
    </div>
  </div>
</Default>
