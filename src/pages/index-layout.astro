---
import Layout from '@layouts/Default.astro';

const skills = {
  languages: ['TypeScript', 'Python', 'Rust', 'C'],
  frontend: ['React', 'Three Fiber', 'WebGL'],
  backend: ['Node.js', 'FastAPI', 'SQL'],
  systems: ['Linux', 'Docker', 'Systems'],
};

const projects = [
  {
    name: 'Shefixu',
    subtitle: '3D AI Companion',
    tech: 'TypeScript • React • WebGL • FastAPI',
    description:
      'Real-time conversational 3D interface with VRM avatars and synchronized lip-sync using Web Audio FFT analysis.',
    link: 'https://github.com/lumacodes',
  },
  {
    name: 'HNLINK',
    subtitle: 'Content Automation',
    tech: 'Python • APIs • Web Scraping',
    description:
      'Pipeline that curates trending Hacker News posts and transforms them into polished LinkedIn content automatically.',
    link: 'https://github.com/lumacodes',
  },
  {
    name: 'Gentoo Kernel',
    subtitle: 'Systems Optimization',
    tech: 'Linux • Systems • Performance',
    description:
      'Finely tuned minimal kernel configuration prioritizing hardware efficiency and removing cruft.',
    link: 'https://github.com/lumacodes',
  },
];

const stats = [
  { label: 'GitHub Repos', value: '22+' },
  { label: 'Years Coding', value: '5+' },
  { label: 'Projects Built', value: '15+' },
];
---

<Layout
  title='Home'
  pageTitle='Subhajit Kumar Das | Product Engineer'
  description='B.Tech Information Technology student building AI systems and full-stack products.'
>
  <main class='bg-white'>
    <div class='grid grid-cols-1 lg:grid-cols-4 min-h-screen'>
      {/* Left Column - Main Content (spans 2.5 out of 4) */}
      <div class='lg:col-span-3 border-r border-black/10'>
        {/* Hero Section */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <div class='mb-8 space-y-3'>
              <p class='text-xs font-medium uppercase tracking-[0.15em] text-black/50'>
                Product Engineer
              </p>
              <h1 class='text-4xl font-black leading-tight sm:text-5xl md:text-6xl lg:text-6xl tracking-tighter'>
                Subhajit Kumar Das
              </h1>
            </div>

            <p class='mb-8 text-base sm:text-lg md:text-lg font-light leading-relaxed text-black/70 max-w-2xl'>
              B.Tech Information Technology student building at the intersection of AI systems,
              full-stack engineering, and thoughtful product design.
            </p>

            <div class='flex flex-wrap gap-3 text-sm'>
              <a href='https://github.com/lumacodes' target='_blank' rel='noopener' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>GitHub</span>
              </a>
              <a href='https://linkedin.com/in/subhajitkumardas' target='_blank' rel='noopener' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>LinkedIn</span>
              </a>
              <a href='https://subhajitdas.hashnode.dev' target='_blank' rel='noopener' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>Blog</span>
              </a>
              <a href='https://luma.is-a.dev' class='inline-flex items-center gap-2 hover:opacity-60 transition-opacity border-b border-black/30 hover:border-black/60'>
                <span>→</span>
                <span>Website</span>
              </a>
            </div>
          </div>
        </section>

        {/* Projects Section */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <h2 class='mb-10 text-2xl sm:text-3xl md:text-4xl font-black tracking-tight'>
              Selected Work
            </h2>

            <div class='space-y-10'>
              {projects.map((project, idx) => (
                <a
                  href={project.link}
                  target='_blank'
                  rel='noopener'
                  class='group block'
                >
                  <article class='border-l-4 border-transparent hover:border-black/60 pl-6 py-2 transition-all duration-300'>
                    <div class='mb-3 flex flex-col gap-2'>
                      <div class='flex items-baseline gap-3'>
                        <span class='text-lg text-black/40 font-light'>0{idx + 1}</span>
                        <h3 class='text-2xl sm:text-3xl font-bold'>{project.name}</h3>
                      </div>
                      <span class='text-xs sm:text-sm text-black/50 italic font-light'>{project.subtitle}</span>
                    </div>
                    <p class='mb-3 text-xs uppercase tracking-[0.08em] text-black/40 font-medium'>
                      {project.tech}
                    </p>
                    <p class='text-sm sm:text-base leading-relaxed text-black/70'>
                      {project.description}
                    </p>
                    <div class='mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300'>
                      <span class='text-xs sm:text-sm font-medium flex items-center gap-2'>
                        <span>→</span>
                        <span>View Repository</span>
                      </span>
                    </div>
                  </article>
                </a>
              ))}
            </div>
          </div>
        </section>

        {/* Skills Section */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <h2 class='mb-10 text-2xl sm:text-3xl md:text-4xl font-black tracking-tight'>
              Technical Stack
            </h2>

            <div class='grid gap-8 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4'>
              {Object.entries(skills).map(([category, items]) => (
                <div class='space-y-3'>
                  <h3 class='text-xs font-bold uppercase tracking-[0.12em] text-black/50 flex items-center gap-2'>
                    <span>▸</span>
                    <span>{category.replace(/([A-Z])/g, ' $1').trim()}</span>
                  </h3>
                  <ul class='space-y-2 pl-4'>
                    {items.map((skill) => (
                      <li class='text-sm text-black/80'>• {skill}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Open Source & Education */}
        <section class='border-b border-black/10 px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div class='grid gap-10 sm:gap-12 md:grid-cols-2'>
            <div class='space-y-4'>
              <h2 class='text-lg sm:text-xl font-bold flex items-center gap-2'>
                <span>◆</span>
                <span>Open Source</span>
              </h2>
              <p class='text-sm leading-relaxed text-black/70'>
                Contributed to <a href='https://github.com/is-a-dev/register' class='underline hover:opacity-60 transition-opacity'>is-a-dev/register</a>, maintaining free developer subdomains. Active on GitHub with 22+ public repositories spanning AI, automation, systems, and tooling.
              </p>
            </div>
            <div class='space-y-4'>
              <h2 class='text-lg sm:text-xl font-bold flex items-center gap-2'>
                <span>◆</span>
                <span>Education</span>
              </h2>
              <div>
                <p class='text-sm font-medium text-black/90'>B.Tech in Information Technology</p>
                <p class='text-xs sm:text-sm text-black/70 leading-relaxed'>
                  Guru Nanak Institute of Technology<br />
                  2025 – 2029
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* Interests Section */}
        <section class='px-4 py-12 sm:px-6 md:px-8 md:py-20'>
          <div>
            <h2 class='mb-8 text-lg sm:text-xl font-bold flex items-center gap-2'>
              <span>◆</span>
              <span>Interests & Focus</span>
            </h2>
            <div class='flex flex-wrap gap-2 sm:gap-3'>
              {['AI Systems', 'Developer Tooling', 'Linux Internals', 'Privacy Tech', '3D Interfaces', 'Open Source'].map((interest) => (
                <span class='px-3 py-2 border border-black/20 text-xs sm:text-sm font-medium rounded hover:bg-black/5 hover:border-black/40 transition-all cursor-pointer'>
                  {interest}
                </span>
              ))}
            </div>
          </div>
        </section>
      </div>

      {/* Right Sidebar (1 column out of 4) */}
      <aside class='hidden lg:flex lg:flex-col bg-[#f9f7f4] sticky top-0 h-screen px-6 py-8 gap-8 overflow-y-auto'>
        {/* Quick Stats */}
        <div class='space-y-4'>
          <h3 class='text-xs font-bold uppercase tracking-[0.15em] text-black/60'>Stats</h3>
          <div class='space-y-3'>
            {stats.map((stat) => (
              <div class='flex items-center justify-between'>
                <span class='text-xs text-black/60'>{stat.label}</span>
                <span class='text-lg font-bold text-black'>{stat.value}</span>
              </div>
            ))}
          </div>
        </div>

        <div class='w-full h-px bg-black/10'></div>

        {/* Status */}
        <div class='space-y-4'>
          <h3 class='text-xs font-bold uppercase tracking-[0.15em] text-black/60'>Status</h3>
          <div class='flex items-center gap-2'>
            <span class='w-2 h-2 bg-green-500 rounded-full animate-pulse'></span>
            <span class='text-sm text-black/80'>Open for collaborations & opportunities</span>
          </div>
        </div>

        <div class='w-full h-px bg-black/10'></div>

        {/* Quick Skills */}
        <div class='space-y-4'>
          <h3 class='text-xs font-bold uppercase tracking-[0.15em] text-black/60'>Key Skills</h3>
          <div class='flex flex-wrap gap-2'>
            {['AI', 'React', 'Python', 'Systems', 'Full-Stack'].map((skill) => (
              <span class='px-2 py-1 bg-black/10 text-xs font-medium rounded text-black/80'>
                {skill}
              </span>
            ))}
          </div>
        </div>

        <div class='w-full h-px bg-black/10'></div>

        {/* Contact CTA */}
        <div class='space-y-3'>
          <a 
            href='mailto:subhajit@luma.is-a.dev' 
            class='flex w-full items-center justify-center px-4 py-3 bg-black text-white text-xs font-bold uppercase tracking-[0.1em] hover:bg-black/90 transition-all'
          >
            Get in Touch
          </a>
        </div>
      </aside>
    </div>
  </main>
</Layout>

<style>
  a {
    transition: opacity 0.2s ease;
  }

  a:hover {
    opacity: 0.6;
  }
</style>
